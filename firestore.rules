rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép đọc tự do (hiển thị phim cho người dùng)
    // KHÔNG cho phép ghi từ Client (Chỉ PHP Backend sử dụng Service Account mới được ghi)
    match /{document=**} {
      allow read: if true;
      allow write: if false; 
    }
  }
}
