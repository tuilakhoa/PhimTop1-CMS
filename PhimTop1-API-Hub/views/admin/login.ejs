<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background-color: #0d1117; color: #c9d1d9; font-family: ui-sans-serif, system-ui, -apple-system, sans-serif; }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center">
    <div class="bg-[#161b22] border border-[#30363d] p-8 rounded-xl w-full max-w-md">
        <h2 class="text-2xl font-bold text-white mb-6 text-center">Admin Login</h2>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-500/10 border border-red-500/50 text-red-400 p-3 rounded mb-4 text-sm"><%= error %></div>
        <% } %>
        <form action="/admin/login" method="POST" class="flex flex-col gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-400 mb-1">Tài khoản</label>
                <input type="text" name="username" class="w-full bg-[#0d1117] border border-[#30363d] rounded p-2.5 text-white outline-none focus:border-cyan-500" required>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-400 mb-1">Mật khẩu</label>
                <input type="password" name="password" class="w-full bg-[#0d1117] border border-[#30363d] rounded p-2.5 text-white outline-none focus:border-cyan-500" required>
            </div>
            <button type="submit" class="w-full bg-cyan-600 hover:bg-cyan-500 text-white font-medium py-2.5 rounded mt-2 transition">Đăng nhập</button>
        </form>
    </div>
</body>
</html>
