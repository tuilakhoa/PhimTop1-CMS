    <script>
        lucide.createIcons();
        
        async function watchMovie(slug) {
            try {
                const btn = document.querySelector('button[onclick^="watchMovie"]');
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="animate-spin w-4 h-4 border-2 border-white border-t-transparent rounded-full"></i> Đang tải...';
                
                const res = await fetch('/api/phim/' + slug);
                const data = await res.json();
                
                if (data.status && data.episodes && data.episodes.length > 0 && data.episodes[0].server_data.length > 0) {
                    const embedUrl = data.episodes[0].server_data[0].link_embed;
                    if (embedUrl) {
                        window.open(embedUrl, '_blank');
                    } else {
                        alert('Chưa có link xem phim (Embed URL) cho tập này.');
                    }
                } else {
                    alert('Phim này hiện tại chưa cập nhật tập nào!');
                }
                btn.innerHTML = originalText;
                lucide.createIcons();
            } catch (err) {
                alert('Lỗi tải dữ liệu phim!');
                console.error(err);
            }
        }
    </script>

    <script>
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        if (menuBtn && mobileMenu) {
            menuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });
        }
    </script>
