<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <% 
        let pageTitle = "PhimTop1 API";
        let pageDesc = "PhimTop1 API Hub cung cấp nền tảng dữ liệu phim đa định dạng JSON/XML tốc độ cao, miễn phí và không giới hạn băng thông dành cho Developer & Webmaster.";
        let pageUrl = "https://api.phimtop1.asia";
        if (locals.isSearch) {
            pageTitle = "Tìm kiếm: " + keyword + " - PhimTop1 API";
            pageUrl += "/search?keyword=" + encodeURIComponent(keyword);
        } else if (locals.isCategory) {
            pageTitle = "Phim " + categoryName + " - PhimTop1 API";
            pageUrl += baseUrl;
        }
    %>
    <title><%= typeof settings !== "undefined" && settings.site_title ? settings.site_title : "PhimTop1 API Hub" %></title>
    <meta name="description" content="<%= typeof settings !== "undefined" && settings.site_description ? settings.site_description : "" %>">
    <meta name="keywords" content="api phim, api phim mien phi, code phim, api phim json, api phim xml, phimtop1">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="<%= pageUrl %>">
    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= pageDesc %>">
    <meta property="og:url" content="<%= pageUrl %>">
    <meta property="og:site_name" content="PhimTop1 API">
    <!-- Twitter -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= pageTitle %>">
    <meta name="twitter:description" content="<%= pageDesc %>">

    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body { background-color: #121418; color: #a1a1aa; font-family: ui-sans-serif, system-ui, -apple-system, sans-serif; }
        .bg-card { background-color: #181a20; }
        .border-card { border-color: #272a30; }
        .text-kk-red { color: #f43f5e; }
        .bg-kk-red { background-color: #f43f5e; }
        .text-kk-blue { color: #38bdf8; }
        .header-border { border-bottom: 2px solid #5a0000; }
    </style>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎬</text></svg>">
    <meta name="msvalidate.01" content="3272BDE866C77FFFE8499EB05F224A6B" />
</head>
<body class="min-h-screen flex flex-col">

    <!-- Navbar -->
    <header class="border-b border-card bg-[#0b0c0f] sticky top-0 z-50">
        <div class="max-w-[1440px] mx-auto px-4 sm:px-6 py-2">
            <div class="flex items-center justify-between h-14">
                <div class="flex items-center gap-6">
                    <a href="/" class="flex items-center gap-2 font-black text-2xl tracking-tighter hover:opacity-80 transition">
                        <i data-lucide="clapperboard" class="w-7 h-7 text-orange-500"></i>
                        <span class="text-orange-500">PhimTop1<span class="text-kk-blue">API</span></span>
                    </a>
                    <nav class="hidden md:flex items-center gap-6 text-sm font-bold text-gray-300 ml-4">
                        <div class="relative group">
                            <a href="#" class="hover:text-white transition py-4 flex items-center gap-1">Thể Loại <i data-lucide="chevron-down" class="w-3 h-3"></i></a>
                            <div class="absolute left-0 top-full -mt-2 w-[600px] bg-[#111319]/95 backdrop-blur-xl border border-gray-800 rounded-xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50 p-5 grid grid-cols-4 gap-x-2 gap-y-1.5 max-h-[65vh] overflow-y-auto custom-scrollbar">
                                <% if(locals.globalGenres) { 
                                    const sorted = [...globalGenres].sort((a,b) => a.name.localeCompare(b.name, 'vi'));
                                    sorted.forEach(g => { %>
                                    <a href="/the-loai/<%= g.slug %>" class="text-gray-400 hover:text-white hover:bg-white/10 text-[13px] py-2 px-3 rounded-lg transition-all capitalize truncate font-medium"><%= g.name %></a>
                                <% }) } %>
                            </div>
                        </div>
                        <div class="relative group">
                            <a href="#" class="hover:text-white transition py-4 flex items-center gap-1">Quốc Gia <i data-lucide="chevron-down" class="w-3 h-3"></i></a>
                            <div class="absolute left-0 top-full -mt-2 w-[600px] bg-[#111319]/95 backdrop-blur-xl border border-gray-800 rounded-xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50 p-5 grid grid-cols-4 gap-x-2 gap-y-1.5 max-h-[65vh] overflow-y-auto custom-scrollbar">
                                <% if(locals.globalCountries) { 
                                    const sorted = [...globalCountries].sort((a,b) => a.name.localeCompare(b.name, 'vi'));
                                    sorted.forEach(c => { %>
                                    <a href="/quoc-gia/<%= c.slug %>" class="text-gray-400 hover:text-white hover:bg-white/10 text-[13px] py-2 px-3 rounded-lg transition-all capitalize truncate font-medium"><%= c.name %></a>
                                <% }) } %>
                            </div>
                        </div>
                        <div class="relative group">
                            <a href="#" class="hover:text-white transition py-4 flex items-center gap-1">Danh Sách <i data-lucide="chevron-down" class="w-3 h-3"></i></a>
                            <div class="absolute left-0 top-full -mt-2 w-48 bg-[#181a20] border border-[#272a30] rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 flex flex-col p-2">
                                <a href="/danh-sach/phim-le" class="text-gray-400 hover:text-white hover:bg-gray-800 text-sm py-2 px-3 rounded transition">Phim Lẻ</a>
                                <a href="/danh-sach/phim-bo" class="text-gray-400 hover:text-white hover:bg-gray-800 text-sm py-2 px-3 rounded transition">Phim Bộ</a>
                                <a href="/danh-sach/hoat-hinh" class="text-gray-400 hover:text-white hover:bg-gray-800 text-sm py-2 px-3 rounded transition">Hoạt Hình</a>
                                <a href="/danh-sach/tvshows" class="text-gray-400 hover:text-white hover:bg-gray-800 text-sm py-2 px-3 rounded transition">TV Shows</a>
                            </div>
                        </div>
                        <a href="/api-document" class="hover:text-white transition py-4 flex items-center gap-1 ml-4 border-l border-gray-800 pl-6 text-kk-blue">
                            <i data-lucide="book-open" class="w-4 h-4"></i> Tài liệu API
                        </a>
                        <a href="/cms" class="hover:text-white transition py-4 flex items-center gap-1 text-kk-red">
                            <i data-lucide="download" class="w-4 h-4"></i> Tải CMS
                        </a>
                    </nav>
                </div>
                <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-400 hover:text-white">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
                <div class="hidden lg:flex items-center gap-4">
                    <form action="/search" method="GET" class="relative">
                        <input type="text" name="keyword" placeholder="Tìm kiếm phim..." value="<%= typeof keyword !== 'undefined' ? keyword : '' %>" class="bg-[#1e2128] border border-gray-700 text-sm rounded-md pl-9 pr-4 py-1.5 text-white focus:outline-none focus:border-gray-500 w-56">
                        <button type="submit" class="absolute left-3 top-2"><i data-lucide="search" class="w-4 h-4 text-gray-500"></i></button>
                    </form>
                </div>
            </div>
            
            <!-- Mobile Search Bar (visible only on small screens) -->
            <div class="flex lg:hidden mt-2 pb-2">
                <form action="/search" method="GET" class="relative w-full">
                    <input type="text" name="keyword" placeholder="Tìm kiếm phim..." value="<%= typeof keyword !== 'undefined' ? keyword : '' %>" class="w-full bg-[#1e2128] border border-gray-700 text-sm rounded-md pl-9 pr-4 py-2 text-white focus:outline-none focus:border-gray-500">
                    <button type="submit" class="absolute left-3 top-2.5"><i data-lucide="search" class="w-4 h-4 text-gray-500"></i></button>
                </form>
            </div>
        </div>
    
        <!-- Mobile Dropdown Menu -->
        <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-[#0b0c0f] border-b border-[#272a30] p-4 shadow-2xl z-50 overflow-y-auto max-h-[80vh]">
            
            <a href="/api-document" class="flex items-center gap-2 font-bold text-white mb-4 bg-[#181a20] p-3 rounded-lg border border-gray-800 transition active:bg-gray-800">
                <i data-lucide="file-code" class="w-5 h-5 text-kk-red"></i> Tài liệu API
            </a>
            
            <div class="mb-4">
                <button onclick="document.getElementById('mobile-genre-list').classList.toggle('hidden')" class="w-full font-bold text-gray-300 flex items-center justify-between uppercase text-xs tracking-wider bg-[#181a20] p-3 rounded-lg border border-gray-800 transition active:bg-gray-800">
                    <span class="flex items-center gap-2"><i data-lucide="film" class="w-4 h-4 text-kk-blue"></i> Thể Loại</span>
                    <i data-lucide="chevron-down" class="w-4 h-4"></i>
                </button>
                <div id="mobile-genre-list" class="hidden grid grid-cols-2 gap-3 p-4 mt-2 bg-[#0b0c0f] rounded-lg border border-[#272a30] max-h-[300px] overflow-y-auto custom-scrollbar">
                    <% if(locals.globalGenres) { 
                        const sorted = [...globalGenres].sort((a,b) => a.name.localeCompare(b.name, 'vi'));
                        sorted.forEach(g => { %>
                        <a href="/the-loai/<%= g.slug %>" class="text-gray-400 text-[13px] hover:text-white truncate capitalize"><%= g.name %></a>
                    <% }) } %>
                </div>
            </div>
            
            <div class="mb-2">
                <button onclick="document.getElementById('mobile-list-list').classList.toggle('hidden')" class="w-full font-bold text-gray-300 flex items-center justify-between uppercase text-xs tracking-wider bg-[#181a20] p-3 rounded-lg border border-gray-800 transition active:bg-gray-800">
                    <span class="flex items-center gap-2"><i data-lucide="list" class="w-4 h-4 text-orange-400"></i> Danh Sách</span>
                    <i data-lucide="chevron-down" class="w-4 h-4"></i>
                </button>
                <div id="mobile-list-list" class="hidden flex flex-col gap-3 p-4 mt-2 bg-[#0b0c0f] rounded-lg border border-[#272a30]">
                    <a href="/danh-sach/series" class="text-gray-400 text-[13px] hover:text-white">Phim Bộ</a>
                    <a href="/danh-sach/single" class="text-gray-400 text-[13px] hover:text-white">Phim Lẻ</a>
                    <a href="/danh-sach/hoathinh" class="text-gray-400 text-[13px] hover:text-white">Hoạt Hình</a>
                    <a href="/danh-sach/tvshows" class="text-gray-400 text-[13px] hover:text-white">TV Shows</a>
                </div>
            </div>
            <div class="mb-2">
                <button onclick="document.getElementById('mobile-country-list').classList.toggle('hidden')" class="w-full font-bold text-gray-300 flex items-center justify-between uppercase text-xs tracking-wider bg-[#181a20] p-3 rounded-lg border border-gray-800 transition active:bg-gray-800">
                    <span class="flex items-center gap-2"><i data-lucide="globe" class="w-4 h-4 text-purple-400"></i> Quốc Gia</span>
                    <i data-lucide="chevron-down" class="w-4 h-4"></i>
                </button>
                <div id="mobile-country-list" class="hidden grid grid-cols-2 gap-3 p-4 mt-2 bg-[#0b0c0f] rounded-lg border border-[#272a30] max-h-[300px] overflow-y-auto custom-scrollbar">
                    <% if(locals.globalCountries) { 
                        const sorted = [...globalCountries].sort((a,b) => a.name.localeCompare(b.name, 'vi'));
                        sorted.forEach(c => { %>
                        <a href="/quoc-gia/<%= c.slug %>" class="text-gray-400 text-[13px] hover:text-white truncate capitalize"><%= c.name %></a>
                    <% }) } %>
                </div>
            </div>
            
        </div>
    </header>

    <main class="flex-grow max-w-[1440px] mx-auto px-4 sm:px-6 py-10 w-full">
        
        <!-- Feature Cards (2x2 Grid) -->
        <% if (locals.isCategory) { %>
        <div class="mb-6 text-xl font-bold text-white"><i data-lucide="folder" class="w-5 h-5 inline mr-1 text-kk-blue"></i> <%= typeof categoryType !== 'undefined' ? (categoryType === 'genre' ? 'Thể loại' : (categoryType === 'country' ? 'Quốc gia' : 'Danh sách')) : 'Danh sách' %>: <span class="text-kk-red"><%= categoryName %></span> (<%= totalMovies %> phim)</div>
        <% } else if (locals.isSearch) { %>
        <div class="mb-6 text-xl font-bold text-white">Kết quả tìm kiếm cho: <span class="text-kk-red">"<%= keyword %>"</span> (<%= totalMovies %> phim)</div>
        <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
            
            <div class="bg-card border border-card rounded-xl p-6 hover:border-gray-600 transition">
                <div class="flex items-center gap-2 text-kk-red text-xs font-bold mb-2 uppercase">
                    <i data-lucide="film" class="w-4 h-4"></i> PHIMTOP1 API
                </div>
                <h3 class="text-2xl font-bold text-white mb-2">Kho phim khổng lồ</h3>
                <p class="text-sm text-gray-400 mb-6">Cập nhật liên tục từ bom tấn mới ra rạp đến series kinh điển.</p>
                <div class="flex gap-6 text-sm font-bold">
                    <div class="flex items-center gap-2"><div class="w-2.5 h-2.5 rounded-full bg-kk-red"></div> Hôm nay: <span class="text-white"><%= locals.todayMovies || 0 %></span></div>
                    <div class="flex items-center gap-2"><div class="w-2.5 h-2.5 rounded-full bg-orange-500"></div> Tổng: <span class="text-white"><%= totalMovies.toLocaleString('en-GB') %></span></div>
                </div>
            </div>
            
            <div class="bg-card border border-card rounded-xl p-6 hover:border-gray-600 transition">
                <div class="flex items-center gap-2 text-kk-blue text-xs font-bold mb-2 uppercase">
                    <i data-lucide="radio" class="w-4 h-4"></i> FAST STREAMING
                </div>
                <h3 class="text-2xl font-bold text-white mb-2">Xem mượt - Không giật lag</h3>
                <p class="text-sm text-gray-400 mb-6">Hạ tầng CDN băng thông lớn, đảm bảo tốc độ phát nhanh và ổn định.</p>
                <div class="flex gap-4 text-xs font-bold text-gray-300">
                    <span class="flex items-center gap-1.5"><div class="w-2 h-2 rounded-full bg-kk-red"></div> 99.9% Uptime</span>
                    <span class="flex items-center gap-1.5"><div class="w-2 h-2 rounded-full bg-green-500"></div> 100+ Gbps</span>
                    <span class="flex items-center gap-1.5"><div class="w-2 h-2 rounded-full bg-yellow-500"></div> -30ms Ping</span>
                </div>
            </div>
            
            <div class="bg-card border border-card rounded-xl p-6 hover:border-gray-600 transition">
                <div class="flex items-center gap-2 text-purple-400 text-xs font-bold mb-2 uppercase">
                    <i data-lucide="server" class="w-4 h-4"></i> CMS & API
                </div>
                <h3 class="text-2xl font-bold text-white mb-2">Tiết kiệm tối đa cho Developer</h3>
                <p class="text-sm text-gray-400 mb-4">Không cần server, không lo lưu trữ - Tích hợp API dễ dàng.</p>
                <div class="flex gap-2">
                    <span class="px-3 py-1 bg-purple-900/30 text-purple-400 text-xs font-bold rounded-full">API RESTful</span>
                    <a href="/cms" class="px-3 py-1 bg-green-900/30 hover:bg-green-800/50 text-green-400 text-xs font-bold rounded-full transition cursor-pointer">CMS Open Source</a>
                </div>
            </div>

            <div class="bg-card border border-card rounded-xl p-6 hover:border-gray-600 transition">
                <div class="flex items-center gap-2 text-green-500 text-xs font-bold mb-2 uppercase">
                    <i data-lucide="package" class="w-4 h-4"></i> FREE
                </div>
                <h3 class="text-2xl font-bold text-white mb-2">100% Miễn phí</h3>
                <p class="text-sm text-gray-400 mb-5">Không phí bản quyền, không giới hạn.</p>
                <div class="flex gap-4 text-xs font-bold text-gray-300">
                    <span class="flex items-center gap-1.5"><div class="w-2 h-2 rounded-full bg-green-500"></div> Không ràng buộc</span>
                    <span class="flex items-center gap-1.5"><div class="w-2 h-2 rounded-full bg-green-500"></div> Tự do sử dụng</span>
                </div>
            </div>
        </div>
        <% } %>

        <!-- Movie List Table -->
        <div class="bg-card border border-card rounded-xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="text-[11px] text-gray-300 font-bold uppercase bg-[#181a20] header-border">
                        <tr>
                            <th class="px-6 py-4 w-1/3">THÔNG TIN</th>
                            <th class="px-4 py-4 text-center">NĂM</th>
                            <th class="px-4 py-4 text-center">TÌNH TRẠNG</th>
                            <th class="px-4 py-4 text-center">TMDB</th>
                            <th class="px-4 py-4 text-center">IMDB</th>
                            <th class="px-4 py-4 text-center">ĐỊNH DẠNG</th>
                            <th class="px-4 py-4 text-center">QUỐC GIA</th>
                            <th class="px-6 py-4 text-right">CẬP NHẬT</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#272a30]">
                        <% if(movies && movies.length > 0) { %>
                            <% movies.forEach(movie => { %>
                                <tr class="hover:bg-white/5 transition">
                                    <td class="px-6 py-3">
                                        <div class="flex items-center gap-4">
                                            <div class="w-[50px] h-[70px] rounded overflow-hidden flex-shrink-0 bg-gray-800">
                                                <img src="<%= movie.thumb_url %>" class="w-full h-full object-cover" alt="<%= movie.name %>" onerror="this.src='https://via.placeholder.com/50x70'">
                                            </div>
                                            <div class="flex flex-col justify-center">
                                                <a href="/phim/<%= movie.slug %>" class="block font-bold text-white text-[15px] hover:text-orange-400 cursor-pointer line-clamp-1 mb-1"><%= movie.name %></a>
                                                <div class="text-xs text-gray-500 line-clamp-1"><%= movie.origin_name || movie.slug %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 text-center text-gray-300 font-medium"><%= movie.year || 'N/A' %></td>
                                    <td class="px-4 py-3">
                                        <% 
                                            let st = movie.status || 'N/A';
                                            if(st.toLowerCase() === 'ongoing') st = 'Đang chiếu';
                                            else if(st.toLowerCase() === 'completed') st = 'Hoàn tất';
                                            else if(st.toLowerCase() === 'trailer') st = 'Trailer';
                                            
                                            // Dùng episode_current nếu có, ngược lại dùng status
                                            let displayText = movie.episode_current ? movie.episode_current : st;
                                        %>
                                        <span class="px-3 py-1 rounded-full text-xs font-bold border border-indigo-500/30 text-indigo-400 bg-indigo-500/10 whitespace-nowrap"><%= displayText %></span>
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-bold rounded border border-blue-500/30 text-blue-400 bg-blue-500/10 whitespace-nowrap">
                                            <i data-lucide="bar-chart-2" class="w-3 h-3"></i> <%= movie.tmdb_vote ? parseFloat(movie.tmdb_vote).toFixed(1) : 'N/A' %>
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-bold rounded border border-yellow-500/30 text-yellow-400 bg-yellow-500/10 whitespace-nowrap">
                                            <i data-lucide="star" class="w-3 h-3"></i> <%= movie.imdb_vote ? parseFloat(movie.imdb_vote).toFixed(1) : 'N/A' %>
                                        </span>
                                    </td>
<td class="px-4 py-3 text-center text-gray-400 text-xs font-bold uppercase">
                                        <%= movie.type === 'series' ? 'PHIM BỘ' : (movie.type === 'single' ? 'PHIM LẺ' : 'HOẠT HÌNH') %>
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        <%
                                        let countryCode = '🏳️';
                                        if (movie.countries_json) {
                                            try {
                                                let countriesArr = JSON.parse(movie.countries_json);
                                                if(countriesArr.length > 0) {
                                                    let slug = countriesArr[0].slug;
                                                    const flagMap = {
                                                        'han-quoc': '🇰🇷', 'trung-quoc': '🇨🇳', 'nhat-ban': '🇯🇵', 'thai-lan': '🇹🇭',
                                                        'au-my': '🇺🇸', 'viet-nam': '🇻🇳', 'hong-kong': '🇭🇰', 'dai-loan': '🇹🇼',
                                                        'an-do': '🇮🇳', 'anh': '🇬🇧', 'phap': '🇫🇷', 'tay-ban-nha': '🇪🇸',
                                                        'duc': '🇩🇪', 'nga': '🇷🇺', 'y': '🇮🇹', 'mexico': '🇲🇽', 'uc': '🇦🇺'
                                                    };
                                                    countryCode = flagMap[slug] || '🏳️';
                                                }
                                            } catch(e){}
                                        }
                                        %>
                                        <span class="text-xl" title="Quốc gia"><%= countryCode %></span>
                                    </td>
                                    <td class="px-6 py-3 text-right text-kk-red font-bold text-xs flex items-center justify-end gap-1.5 h-full mt-5">
                                        <i data-lucide="calendar" class="w-3 h-3"></i> <%= new Date(movie.updated_at || Date.now()).toLocaleString('en-GB') %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="px-6 py-12 text-center text-gray-500">Chưa có dữ liệu phim.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination -->
            <div class="px-6 py-5 border-t border-card flex flex-col md:flex-row justify-between items-center gap-4 bg-[#121418]">
            <div class="text-sm text-gray-400 font-bold hidden md:block">
                Tổng: <span class="text-white"><%= locals.totalMovies || 0 %></span> phim
            </div>
            <% 
                let pgBase = locals.baseUrl ? locals.baseUrl : '/';
                let qMark = pgBase.includes('?') ? '&' : '?';
                if (locals.isSearch) { pgBase = '/search'; }
                
                let limit = 36;
                let totalPages = Math.ceil((locals.totalMovies || 0) / limit);
                if (totalPages < 1) totalPages = 1;
            %>
            <div class="flex items-center gap-2">
                <% if(page > 1) { %>
                    <a href="<%= pgBase %><%= locals.isSearch ? '?keyword=' + encodeURIComponent(keyword) + '&' : qMark %>page=<%= page - 1 %>" class="px-4 py-2 bg-[#181a20] border border-gray-700 hover:bg-gray-800 text-white rounded text-sm font-bold transition">Trang trước</a>
                <% } %>
                
                <span class="px-4 py-2 bg-kk-red text-white rounded text-sm font-bold whitespace-nowrap">Trang <%= page %> / <%= totalPages %></span>
                
                <% if(page < totalPages) { %>
                    <a href="<%= pgBase %><%= locals.isSearch ? '?keyword=' + encodeURIComponent(keyword) + '&' : qMark %>page=<%= page + 1 %>" class="px-4 py-2 bg-[#181a20] border border-gray-700 hover:bg-gray-800 text-white rounded text-sm font-bold transition">Trang sau</a>
                <% } %>
            </div>
            
            <form action="<%= pgBase %>" method="GET" class="flex items-center gap-2">
                <% if(locals.isSearch) { %><input type="hidden" name="keyword" value="<%= keyword %>"><% } %>
                <input type="number" name="page" min="1" max="<%= totalPages %>" placeholder="Trang..." class="w-24 bg-[#181a20] border border-gray-700 text-sm rounded px-3 py-1.5 text-white focus:outline-none focus:border-gray-500">
                <button type="submit" class="px-3 py-1.5 bg-[#181a20] hover:bg-gray-700 border border-gray-700 rounded text-gray-300 text-sm font-bold transition">Đến</button>
            </form>
        </div>
        </div>
    </main>

    <footer class="bg-[#0b0c0f] border-t border-card mt-auto text-gray-400">
        <div class="max-w-[1440px] mx-auto px-4 py-10 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Về chúng tôi -->
                <div class="space-y-4">
                    <a href="/" class="flex items-center gap-2 font-black text-2xl tracking-tighter hover:opacity-80 transition inline-block">
                        <i data-lucide="clapperboard" class="w-7 h-7 text-orange-500 inline-block align-middle"></i>
                        <span class="text-orange-500">PhimTop1<span class="text-kk-blue">API</span></span>
                    </a>
                    <p class="text-sm leading-relaxed text-gray-500">
                        PhimTop1 API Hub cung cấp nền tảng dữ liệu phim đa định dạng JSON/XML tốc độ cao, miễn phí và không giới hạn băng thông dành cho Developer & Webmaster.
                    </p>
                    <div class="inline-block px-4 py-2 bg-gray-800/50 rounded-lg border border-gray-700/50 mt-2 hover:bg-gray-800 transition">
                        <a href="https://phimtop1.asia/" target="_blank" class="text-sm flex items-center gap-2 font-bold text-gray-300 hover:text-white">
                            <i data-lucide="monitor-play" class="w-4 h-4 text-orange-500"></i> Xem phim trực tuyến tại PhimTop1.asia
                        </a>
                    </div>
                </div>

                <!-- Liên kết nhanh -->
                <div class="md:pl-12">
                    <h3 class="text-white font-bold mb-4 uppercase text-xs tracking-wider">Liên kết hệ thống</h3>
                    <ul class="space-y-3 text-sm">
                        <li><a href="/" class="hover:text-kk-blue transition flex items-center gap-2"><i data-lucide="chevron-right" class="w-3 h-3"></i> Trang chủ API</a></li>
                        <li><a href="/api-document" class="hover:text-kk-blue transition flex items-center gap-2"><i data-lucide="chevron-right" class="w-3 h-3"></i> Tài liệu hướng dẫn</a></li>
                        <li><a href="/cms" class="hover:text-kk-blue transition flex items-center gap-2"><i data-lucide="chevron-right" class="w-3 h-3"></i> Mã nguồn CMS Mẫu</a></li>
                        <li><a href="https://phimtop1.asia/" target="_blank" class="hover:text-kk-blue transition flex items-center gap-2"><i data-lucide="chevron-right" class="w-3 h-3"></i> PhimTop1.asia</a></li>
                    </ul>
                </div>

                <!-- Hỗ trợ -->
                <div>
                    <h3 class="text-white font-bold mb-4 uppercase text-xs tracking-wider">Trợ giúp & Hỗ trợ</h3>
                    <p class="text-sm text-gray-500 mb-4">Gặp lỗi hoặc cần yêu cầu thêm phim? Hãy liên hệ với chúng tôi.</p>
                    <div class="flex flex-col gap-3">
                        <a href="<%= typeof settings !== "undefined" && settings.telegram_link ? settings.telegram_link : "https://t.me/" %>" target="_blank" class="w-fit text-sm font-bold border border-[#0088cc]/50 hover:bg-[#0088cc]/10 text-gray-300 hover:text-white px-5 py-2 rounded-lg flex items-center gap-2 transition">
                            <i data-lucide="send" class="w-4 h-4 text-[#0088cc]"></i> Cộng đồng Telegram
                        </a>
                        <button class="w-fit text-sm font-bold border border-gray-700 hover:bg-gray-800 text-gray-300 hover:text-white px-5 py-2 rounded-lg flex items-center gap-2 transition">
                            <i data-lucide="mail" class="w-4 h-4 text-orange-500"></i> Yêu cầu cập nhật phim
                        </button>
                    </div>
                </div>
            </div>
            <div class="mt-10 pt-6 border-t border-gray-800/50 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-gray-600">
                <p>&copy; 2026 PhimTop1 API Hub. Vận hành bởi PhimTop1.asia.</p>
                <p>Designed with <i data-lucide="heart" class="w-3 h-3 inline text-red-500"></i> for Developers.</p>
            </div>
        </div>
    </footer>

    <script>
        lucide.createIcons();
    </script>

    <script>
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        if (menuBtn && mobileMenu) {
            menuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });
        }
    </script>
</body>
</html>