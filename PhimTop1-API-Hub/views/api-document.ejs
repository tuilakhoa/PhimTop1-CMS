                    <button onclick="switchTab(event, 'list', 'nodejs')" class="tab-list-btn px-4 py-2.5 text-sm font-bold text-gray-500 hover:text-white border-b-2 border-transparent whitespace-nowrap transition">Node.js</button>
                    <button onclick="switchTab(event, 'list', 'php')" class="tab-list-btn px-4 py-2.5 text-sm font-bold text-gray-500 hover:text-white border-b-2 border-transparent whitespace-nowrap transition">PHP (JSON)</button>
                    <button onclick="switchTab(event, 'list', 'php-xml')" class="tab-list-btn px-4 py-2.5 text-sm font-bold text-gray-500 hover:text-white border-b-2 border-transparent whitespace-nowrap transition">PHP (XML)</button>
                    <button onclick="switchTab(event, 'list', 'python')" class="tab-list-btn px-4 py-2.5 text-sm font-bold text-gray-500 hover:text-white border-b-2 border-transparent whitespace-nowrap transition">Python</button>
                    <button onclick="switchTab(event, 'list', 'go')" class="tab-list-btn px-4 py-2.5 text-sm font-bold text-gray-500 hover:text-white border-b-2 border-transparent whitespace-nowrap transition">Go</button>
