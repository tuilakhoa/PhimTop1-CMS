 = "https://api.phimtop1.asia/api/danh-sach?page=1";
 = file_get_contents();
 = json_decode(, true);
print_r();
?&gt;</code></pre>
                    </div>
                    <div id="tab-list-php-xml" class="tab-list-content hidden">
                        <pre><code>&lt;?php
