<Page
    x:Class="PhimTop1WinUI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhimTop1WinUI.Views"
    xmlns:models="using:PhimTop1WinUI.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <GridView ItemsSource="{x:Bind ViewModel.Movies, Mode=OneWay}" Margin="20">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Movie">
                    <StackPanel Width="150" Margin="10">
                        <Image Source="{x:Bind ThumbUrl}" Width="150" Height="225" Stretch="UniformToFill" />
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>