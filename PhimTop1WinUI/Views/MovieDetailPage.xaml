<Page
    x:Class="PhimTop1WinUI.Views.MovieDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PhimTop1WinUI.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="30">
                <Button Content="← Quay lại" Click="BackButton_Click" Margin="0,0,0,20" Style="{StaticResource TextBlockButtonStyle}"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border CornerRadius="8" Grid.Column="0">
                        <Image x:Name="PosterImage" Width="200" Height="300" Stretch="UniformToFill" />
                    </Border>
                    
                    <StackPanel Grid.Column="1" Margin="30,0,0,0">
                        <TextBlock x:Name="TitleText" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="OriginTitleText" FontSize="18" Foreground="Gray" Margin="0,5,0,20"/>
                        
                        <Button Content="▶ Xem Phim" Style="{StaticResource AccentButtonStyle}" Width="150" Height="40" CornerRadius="20"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
