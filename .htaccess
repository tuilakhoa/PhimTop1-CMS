DirectoryIndex index.php index.html
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Pass Authorization header to PHP
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
    
    Options -MultiViews
    
    # Chặn truy cập trực tiếp vào thư mục includes và file config
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^config\.json$ - [F,L]
    
    # Ẩn đuôi .php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]
    
    # Sitemap
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^sitemap-([0-9]+)\.xml$ sitemap.php?page=$1 [L]

    # SEO URL Rewrites
    RewriteRule ^phim/([^/]+)/?$ movie.php?slug=$1 [QSA,L]
    RewriteRule ^xem-phim/([^/]+)/([^/]+)/?$ watch.php?slug=$1&ep=$2 [QSA,L]
    RewriteRule ^danh-sach-truyen/?$ danh-sach-truyen.php [QSA,L]
    RewriteRule ^truyen/([^/]+)/?$ comic.php?slug=$1 [QSA,L]
    RewriteRule ^doc-truyen/([^/]+)/([^/]+)/?$ read.php?slug=$1&chap=$2 [QSA,L]
    RewriteRule ^danh-sach/([^/]+)/?$ category.php?type=$1 [QSA,L]
    RewriteRule ^the-loai/([^/]+)/?$ category.php?slug=$1&type=the-loai [QSA,L]
    RewriteRule ^quoc-gia/([^/]+)/?$ category.php?slug=$1&type=quoc-gia [QSA,L]
    RewriteRule ^nam/([0-9]+)/?$ category.php?slug=$1&type=nam-phat-hanh [QSA,L]
    RewriteRule ^tim-kiem/?$ search.php [QSA,L]
    RewriteRule ^bang-xep-hang/?$ trending.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    <Files "setup.php">
        Header set X-Robots-Tag "noindex, nofollow"
    </Files>
</IfModule>

<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# ----------------------------------------------------------------------
# Gzip compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    # Force compression for mangled `Accept-Encoding` request headers
    <IfModule mod_setenvif.c>
        <IfModule mod_headers.c>
            SetEnvIfNoCase ^(Accept-EncodXng|X-cept-Encoding|X{15}|~{15}|-{15})$ ^((gzip|deflate)\s*,?\s*)+|[X~-]{4,13}$ HAVE_Accept-Encoding
            RequestHeader append Accept-Encoding "gzip,deflate" env=HAVE_Accept-Encoding
        </IfModule>
    </IfModule>
    # Compress all output labeled with one of the following media types
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE application/atom+xml \
                                      application/javascript \
                                      application/json \
                                      application/ld+json \
                                      application/rss+xml \
                                      application/vnd.geo+json \
                                      application/vnd.ms-fontobject \
                                      application/x-font-ttf \
                                      application/x-web-app-manifest+json \
                                      application/xhtml+xml \
                                      application/xml \
                                      font/opentype \
                                      image/bmp \
                                      image/svg+xml \
                                      image/x-icon \
                                      text/cache-manifest \
                                      text/css \
                                      text/html \
                                      text/plain \
                                      text/vcard \
                                      text/vnd.rim.location.xloc \
                                      text/vtt \
                                      text/x-component \
                                      text/x-cross-domain-policy
    </IfModule>
</IfModule>

# ----------------------------------------------------------------------
# Browser Caching
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # CSS, JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    
    # Media: images, video, audio
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    
    # Webfonts
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType application/x-font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>
